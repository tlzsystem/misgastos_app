# Configuración general de Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-change-me-in-production-9f8e7d6c5b4a3f2e1d0c
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base de datos (Por defecto SQLite en desarrollo; descomentar para PostgreSQL en prod)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://usuario:password@localhost:5432/misgastos_db

# Zona horaria e idioma
TIME_ZONE=America/Santiago
LANGUAGE_CODE=es-cl
CURRENCY_SYMBOL=$

# Google reCAPTCHA v2 ("No soy un robot" Checkbox)
# Obtén tus llaves en: https://www.google.com/recaptcha/admin/create
RECAPTCHA_ENABLED=True
RECAPTCHA_SITE_KEY=tu_site_key_de_google_recaptcha
RECAPTCHA_SECRET_KEY=tu_secret_key_de_google_recaptcha
